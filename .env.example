# Copy this file to .env locally or configure equivalent provider secrets.
# Never commit real values, guild IDs, channel IDs, webhook IDs, tokens, or service-role keys.
DISCORD_BOT_TOKEN=replace_with_discord_bot_token
GUILD_ID=replace_with_target_guild_id
POSTULACION_WEBHOOK_ID=replace_with_authorized_application_webhook_id

# Optional explicit IDs. When omitted, the persistent reconciler registry is used.
POSTULACION_CHANNEL_ID=
REVISION_CHANNEL_ID=
APROBACION_CHANNEL_ID=
CLIPS_CHANNEL_ID=
INTERVIEW_VOICE_CHANNEL_ID=
INTERVIEW_NOTICE_CHANNEL_ID=
BOT_LOGS_CHANNEL_ID=
BOT_ALERTS_CHANNEL_ID=
SYNC_CHANNEL_ID=
AUDIT_CHANNEL_ID=

# The bot rejects application-channel messages unless POSTULACION_WEBHOOK_ID matches.
CROSAIM_WEB_BASE_URL=https://control-center.example.com
CROSAIM_BOT_SYNC_SECRET=replace_with_a_high_entropy_shared_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# This path must be on a persistent provider volume. It stores only reconciler
# registry metadata and IDs; it never stores Discord or Supabase credentials.
CROSAIM_RUNTIME_CONFIG_PATH=/app/data/crosaim-discord.json
